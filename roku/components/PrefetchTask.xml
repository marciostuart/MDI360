<?xml version="1.0" encoding="utf-8" ?>
<component name="PrefetchTask" extends="Task">
  <script type="text/brightscript" uri="pkg:/components/PrefetchTask.brs" />
  <interface>
    <!-- Download entries: { id, url, path }. -->
    <field id="entries" type="array" />
    <!-- { itemId: true } for every file fully stored on this Roku. -->
    <field id="ready" type="assocarray" alwaysNotify="true" />
    <!-- { itemId: localPath } for files stored on this Roku. -->
    <field id="paths" type="assocarray" alwaysNotify="true" />
  </interface>
</component>
