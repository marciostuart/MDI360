# Copie para .env na VPS (ou cole como variaveis de ambiente no Portainer).

# --- Postgres que ja roda na sua VPS ---
# Dentro do Docker use o NOME DO CONTAINER do postgres, nunca localhost.
DATABASE_URL=postgresql://signage:SENHA_FORTE@postgres:5432/signage
DATABASE_POOL_MAX=10
# Ative apenas se o seu Postgres exigir TLS.
# DATABASE_SSL=true

# --- MinIO que ja roda na sua VPS ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=signage-media
S3_ACCESS_KEY_ID=cole_a_access_key_do_minio
S3_SECRET_ACCESS_KEY=cole_a_secret_key_do_minio

# --- Aplicacao ---
# Gere com: openssl rand -hex 32
SESSION_SECRET=troque_por_um_valor_aleatorio_longo
APP_HOST=mdi.360bh.com.br
APP_URL=https://mdi.360bh.com.br
PORT=3000
# E-mails com acesso a Torre de Controle (/torre). Separe por virgula.
PLATFORM_ADMIN_EMAILS=voce@360bh.com.br

# --- Alertas de TV via Evolution API ---
# Credenciais privadas: configure somente no Portainer, nunca no navegador.
EVOLUTION_API_URL=https://sua-evolution-api.exemplo.com
EVOLUTION_API_INSTANCE=nome_da_instancia
EVOLUTION_API_KEY=chave_privada_da_evolution
# Gere com: openssl rand -hex 32
DEVICE_MONITOR_TOKEN=troque_por_um_token_aleatorio

# --- Mercado Pago: faturamento da plataforma ---
# A configuracao principal e feita em Torre > Pagamentos e fica criptografada no banco.
# As variaveis abaixo sao apenas contingencia para instalacoes ainda nao configuradas pela Torre.
# PLATFORM_CREDENTIALS_ENCRYPTION_KEY e opcional; sem ela, SESSION_SECRET deriva a chave de criptografia.
# Nao altere a chave escolhida depois de salvar credenciais, ou sera necessario informa-las novamente.
# PLATFORM_CREDENTIALS_ENCRYPTION_KEY=gere_com_openssl_rand_hex_32
MERCADO_PAGO_PUBLIC_KEY=APP_USR-public-key
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-access-token-privado
MERCADO_PAGO_WEBHOOK_SECRET=segredo-da-assinatura-do-webhook
# ID numerico da conta recebedora, usado na conciliacao antifraude.
MERCADO_PAGO_ACCOUNT_ID=123456789
# false em homologacao; true em producao.
MERCADO_PAGO_LIVE_MODE=false

# --- Site comercial (fica fora desta aplicacao) ---
# Usado nos links "Conhecer a solucao" dentro do sistema.
VITE_PUBLIC_SITE_URL=https://360bh.com.br/pages/midia-digital-indoor
