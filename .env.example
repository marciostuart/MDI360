# Copie para .env na VPS (ou cole como variaveis de ambiente no Portainer).

# --- Postgres que ja roda na sua VPS ---
# Dentro do Docker use o NOME DO CONTAINER do postgres, nunca localhost.
DATABASE_URL=postgresql://signage:SENHA_FORTE@postgres:5432/signage
DATABASE_POOL_MAX=10
# Ative apenas se o seu Postgres exigir TLS.
# DATABASE_SSL=true

# --- MinIO que ja roda na sua VPS ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=signage-media
S3_ACCESS_KEY_ID=cole_a_access_key_do_minio
S3_SECRET_ACCESS_KEY=cole_a_secret_key_do_minio

# --- Aplicacao ---
# Gere com: openssl rand -hex 32
SESSION_SECRET=troque_por_um_valor_aleatorio_longo
APP_HOST=painel.seudominio.com.br
APP_URL=https://painel.seudominio.com.br
PORT=3000